#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=0) uniform accelerationStructureEXT scene;
layout(set=0,binding=1,std430) buffer Pixels { uint pixels[]; } outputData;
layout(push_constant) uniform Push { uint width; uint height; uint frameIndex; } pc;

vec3 faceNormal(uint prim) {
    if(prim<2u) return vec3(0.,1.,0.);
    uint f=(prim-2u)/2u;
    if(f==0u) return vec3(0.,0.,1.);
    if(f==1u) return vec3(1.,0.,0.);
    if(f==2u) return vec3(0.,0.,-1.);
    if(f==3u) return vec3(-1.,0.,0.);
    if(f==4u) return vec3(0.,1.,0.);
    return vec3(0.,-1.,0.);
}
void main() {
    uvec2 id=gl_GlobalInvocationID.xy;
    if(id.x>=pc.width||id.y>=pc.height)return;
    vec2 ndc=(vec2(id)+.5)/vec2(pc.width,pc.height)*2.-1.;
    ndc.y=-ndc.y;
    float aspect=float(pc.width)/float(pc.height);
    vec3 camera=vec3(2.5,2.2,4.7);
    vec3 forward=normalize(vec3(0.,.4,0.)-camera);
    vec3 right=normalize(cross(forward,vec3(0.,1.,0.)));
    vec3 up=normalize(cross(right,forward));
    vec3 ray=normalize(forward+ndc.x*right*aspect*.72+ndc.y*up*.72);

    rayQueryEXT primary;
    rayQueryInitializeEXT(primary,scene,gl_RayFlagsOpaqueEXT,0xff,camera,.01,ray,30.);
    while(rayQueryProceedEXT(primary)){}
    vec3 outColor;
    if(rayQueryGetIntersectionTypeEXT(primary,true)==gl_RayQueryCommittedIntersectionTriangleEXT){
        uint primitive=rayQueryGetIntersectionPrimitiveIndexEXT(primary,true);
        float t=rayQueryGetIntersectionTEXT(primary,true);
        vec3 p=camera+ray*t;
        vec3 n=faceNormal(primitive);
        // Per-dispatch rotating light; scene geometry remains fixed.
        // frameIndex=0 matches the original RT Lab static light.
        float phase = float(pc.frameIndex) * .45;
        vec3 light = normalize(vec3(-.8*cos(phase)-1.1*sin(phase),
                                    1.8,
                                    -.8*sin(phase)+1.1*cos(phase)));
        rayQueryEXT shadow;
        rayQueryInitializeEXT(shadow,scene,gl_RayFlagsOpaqueEXT|gl_RayFlagsTerminateOnFirstHitEXT,0xff,p+n*.035,.02,light,30.);
        while(rayQueryProceedEXT(shadow)){}
        bool occluded=rayQueryGetIntersectionTypeEXT(shadow,true)!=gl_RayQueryCommittedIntersectionNoneEXT;
        float diffuse=max(dot(n,light),0.);
        float lightScale=.17+(occluded?.15:1.0)*.83*diffuse;
        if(primitive<2u){
            float chequer=mod(floor(p.x*1.2)+floor(p.z*1.2),2.);
            vec3 material=mix(vec3(.14,.20,.26),vec3(.22,.29,.36),chequer);
            outColor=material*lightScale+vec3(.035,.055,.075);
        } else {
            vec3 material=vec3(.95,.64,.22);
            outColor=material*lightScale+vec3(.025,.016,.01);
        }
    }else{
        float sky=clamp(ray.y*.5+.5,0.,1.);
        outColor=mix(vec3(.028,.040,.078),vec3(.13,.23,.37),sky);
    }
    outColor=pow(clamp(outColor,0.,1.),vec3(1./2.2));
    outputData.pixels[id.y*pc.width+id.x]=packUnorm4x8(vec4(outColor,1.));
}
